<script nonce="a0d0546ee3b25b96-SJC">
    var googletag = googletag || {};
    googletag.cmd = googletag.cmd || [];
	var isProgrammaticAdsEnabled = window.adConfig?.["programmatic-enabled"] ?? false;
	var isPubGradeEnabled = window.adConfig?.["pubgrade-enabled"] ?? false;
	
	// PERICLES-19717
    window.dvtag = window.dvtag || {};
    dvtag.cmd = dvtag.cmd || [];
	

    function loadScriptDynamically(scriptUrl, callback) {
        var gads = document.createElement('script'),
            node = document.getElementsByTagName('script') [0];
        gads.async = true;
        gads.src = scriptUrl;
        if (callback) {
            gads.onload = callback;
        }
        node.parentNode.insertBefore(gads, node);
    }

	// PERICLES-20612
    const params = new URLSearchParams();
	params.set('site', 'wol');
	params.set('page', window.adobeDataLayer?.[0]?.page?.type || 'n/a');
	params.set('cid', window.adobeDataLayer?.[0]?.page?.type == 'article' ? '' : '');
	params.set('q', window.adobeDataLayer?.[0]?.search?.term || '');
	console.log("[nimble-params] " + params.toString());
	loadScriptDynamically('https://nim.onlinelibrary.wiley.com/v2/data.js?'+ params.toString(), function() {
